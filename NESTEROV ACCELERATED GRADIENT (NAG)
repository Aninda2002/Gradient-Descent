# ============================================================
# IMPORT LIBRARIES
# ============================================================


import numpy as np
import matplotlib.pyplot as plt

# ============================================================
# DATASET
# y = 4x + 3
# ============================================================

X = np.array([[1], [2], [3], [4], [5]], dtype=np.float32)
y = np.array([[7], [11], [15], [19], [23]], dtype=np.float32)

# ============================================================
# FUNCTIONS
# ============================================================

def forward(X, w, b):
    return np.dot(X, w) + b


def compute_loss(y_true, y_pred):
    return np.mean((y_true - y_pred) ** 2)


def gradients(X, y, y_pred):
    m = X.shape[0]
    dw = (-2 / m) * np.dot(X.T, (y - y_pred))
    db = (-2 / m) * np.sum(y - y_pred)
    return dw, db

# ============================================================
# PLOT FUNCTION
# ============================================================

def plot_results(losses, title):

    plt.figure(figsize=(8, 5))
    plt.plot(losses)
    plt.title(title)
    plt.xlabel("Epoch")
    plt.ylabel("Loss")
    plt.grid(True)
    plt.show()

# ============================================================
#  NESTEROV ACCELERATED GRADIENT (NAG)
# ============================================================

w = np.random.randn(1, 1)
b = np.zeros((1,))

vw = np.zeros_like(w)
vb = 0

beta = 0.9
lr = 0.01
epochs = 100

losses = []

for epoch in range(epochs):

    lookahead_w = w - beta * vw
    lookahead_b = b - beta * vb

    y_pred = forward(X, lookahead_w, lookahead_b)

    loss = compute_loss(y, y_pred)
    losses.append(loss)

    dw, db = gradients(X, y, y_pred)

    vw = beta * vw + lr * dw
    vb = beta * vb + lr * db

    w = w - vw
    b = b - vb

print("NAG")
print("Weight:", w)
print("Bias:", b)

plot_results(losses, "Nesterov Accelerated Gradient")
